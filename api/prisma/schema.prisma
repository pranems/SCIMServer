generator client {
  provider        = "prisma-client"
  output          = "../src/generated/prisma"
  previewFeatures = ["postgresqlExtensions"]
}

// Phase 3: PostgreSQL provider - CITEXT for case-insensitive columns, JSONB for
// payload storage, row-level locking for concurrent writes, GIN indexes for
// filter push-down. See docs/phases/PHASE_03_POSTGRESQL_MIGRATION.md
datasource db {
  provider   = "postgresql"
  extensions = [citext, pgcrypto, pg_trgm]
}

// Multi-endpoint support: Each endpoint has isolated SCIM resources
model Endpoint {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name        String   @unique
  displayName String?
  description String?
  profile     Json?    // JSONB - { schemas, resourceTypes, serviceProviderConfig, settings }
  active      Boolean  @default(true)
  createdAt   DateTime @default(now()) @db.Timestamptz
  updatedAt   DateTime @updatedAt     @db.Timestamptz

  // Phase 2: Unified resource relation
  resources ScimResource[]

  // Phase 11: Per-endpoint credentials
  credentials EndpointCredential[]

  @@index([active])
}

model RequestLog {
  id               String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  endpointId       String?  @db.Uuid
  method           String
  url              String
  status           Int?
  durationMs       Int?
  requestHeaders   String
  requestBody      String?
  responseHeaders  String?
  responseBody     String?
  errorMessage     String?
  errorStack       String?
  identifier       String?
  requestId        String?  @db.Uuid          // P3 - the X-Request-Id correlation id, bridges to AuthDecisionTrace.correlationId
  // V10 - the authentication summary for this request, persisted here (not only
  // in the ephemeral AuthDecisionRecordStore) so the logs list shows it
  // instantly + durably. authCredentialId is the winning credential / WIF trust.
  authOutcome      String?                     // 'accept' | 'reject'
  authMethod       String?                     // wif | oauth_client | shared_secret | bearer_jwt | endpoint_bearer
  authReason       String?                     // catalog reason code (reject) or accept note
  authCredentialId String?  @db.Uuid           // V11 - the winning credential / WIF trust id
  // W1 - the FULL, redacted AuthDecisionTrace (checks[] with expected/received,
  // decodedClaims, plane, subTraces) as JSON, so the log detail renders the
  // expected-vs-received diff permanently, not from the 30-min ephemeral store.
  authDecision     String?
  createdAt        DateTime @default(now()) @db.Timestamptz

  // NO foreign key to Endpoint on purpose. RequestLog is an append-only audit
  // record; `endpointId` is a correlation value, not a relational reference.
  // A FK made the buffered batch flush fail (whole `createMany` rejected) when
  // an endpoint was deleted between a row being buffered and the batch being
  // flushed - losing audit rows AND making request-log-readback flaky. Keeping
  // it a plain indexed column means logs for a since-deleted endpoint still
  // persist (and stay queryable by that endpointId), which is what an audit
  // trail must do.

  @@index([createdAt])
  @@index([method])
  @@index([status])
  @@index([endpointId])
  @@index([identifier])
  @@index([requestId])
  @@index([createdAt, method, url])  // Composite for activity summary count queries
}

// ═══════════════════════════════════════════════════════════════════════════════
// Phase 2 → Phase 3 - Unified scim_resource table (PostgreSQL-native)
//
// Polymorphic table: resourceType discriminator ("User" / "Group") determines
// which columns are populated. CITEXT on userName/displayName eliminates the
// need for helper lowercase columns. JSONB payload enables GIN-indexed queries.
// ═══════════════════════════════════════════════════════════════════════════════

model ScimResource {
  id               String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  endpointId       String   @db.Uuid
  resourceType     String   @db.VarChar(50)
  scimId           String   @db.Uuid
  externalId       String?  @db.Text          // TEXT - case-sensitive per RFC 7643 §3.1 (caseExact=true)
  userName         String?  @db.Citext        // CITEXT - case-insensitive natively (Phase 3)
  displayName      String?  @db.Citext        // CITEXT - case-insensitive natively (Phase 3)
  active           Boolean  @default(true)
  payload          Json                        // JSONB - replaces rawPayload String (Phase 3)
  version          Int      @default(1)
  meta             String?
  createdAt        DateTime @default(now()) @db.Timestamptz
  updatedAt        DateTime @updatedAt     @db.Timestamptz

  endpoint         Endpoint         @relation(fields: [endpointId], references: [id], onDelete: Cascade)
  membersAsGroup   ResourceMember[] @relation("GroupMembers")
  membersAsMember  ResourceMember[] @relation("MemberResources")

  // Composite unique constraints
  @@unique([endpointId, scimId])
  @@unique([endpointId, userName])                 // CITEXT handles case-insensitive uniqueness
  // displayName + externalId: NOT unique - saved as received per RFC 7643.
  // Group.displayName uniqueness is enforced at service level only.
  @@index([endpointId, displayName])               // Non-unique index for query perf
  @@index([endpointId, resourceType, externalId])  // Non-unique index for query perf
  @@index([endpointId, resourceType])
}

model ResourceMember {
  id               String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  groupResourceId  String    @db.Uuid
  memberResourceId String?   @db.Uuid
  value            String
  type             String?
  display          String?
  createdAt        DateTime  @default(now()) @db.Timestamptz

  group  ScimResource  @relation("GroupMembers", fields: [groupResourceId], references: [id], onDelete: Cascade)
  member ScimResource? @relation("MemberResources", fields: [memberResourceId], references: [id], onDelete: SetNull)

  // Tier-0 #5: prevent duplicate memberships at DB level. SCIM identifies a
  // member by its `value` sub-attribute (always populated), so this is the
  // correct unique key (memberResourceId is nullable for external members).
  // The migration `20260430120000_resource_member_unique_value` deduplicates
  // any existing rows BEFORE applying the constraint.
  @@unique([groupResourceId, value])
  @@index([groupResourceId])
  @@index([memberResourceId])
}

// ═══════════════════════════════════════════════════════════════════════════════
// Phase 11 - Per-endpoint credentials
//
// Stores bcrypt-hashed bearer tokens or OAuth client credentials scoped to a
// specific endpoint. When the `PerEndpointCredentialsEnabled` config flag is
// true for an endpoint, the SharedSecretGuard will validate incoming tokens
// against this table instead of (or in addition to) the global shared secret.
// ═══════════════════════════════════════════════════════════════════════════════

model EndpointCredential {
  id             String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  endpointId     String    @db.Uuid
  credentialType String    @db.VarChar(50)   // "bearer" | "oauth_client"
  credentialHash String    @db.VarChar(255)  // bcrypt hash of the token/secret
  label          String?   @db.VarChar(255)  // Human-readable label for management
  metadata       Json?                       // {clientId, scopes, ...} for OAuth
  secretEnvelope String?   @db.Text          // WI-7: retained secret, DEK-encrypted (v1.<iv>.<ct>.<tag>); null unless CredentialSecretVisibility=always
  active         Boolean   @default(true)
  createdAt      DateTime  @default(now()) @db.Timestamptz
  expiresAt      DateTime?                   @db.Timestamptz

  // P1 - keyed lookup. The token carries a PUBLIC lookupKey so verification is
  // ONE indexed row + ONE HMAC, instead of a bcrypt compare against every active
  // credential on the endpoint (287 ms each). Nullable because pre-P1 rows have
  // no key and are verified with bcrypt until rotated.
  lookupKey      String?   @unique @db.VarChar(64)
  secretHash     String?   @db.VarChar(128)  // HMAC-SHA256(pepper, secret), hex
  hashAlgo       String    @default("bcrypt") @db.VarChar(32) // "bcrypt" | "hmac-sha256-v1"

  endpoint Endpoint @relation(fields: [endpointId], references: [id], onDelete: Cascade)

  @@index([endpointId, active])
}

// ═══════════════════════════════════════════════════════════════════════════════
// WI-15 - JWKS host allowlist (persisted, admin-editable-at-runtime layer)
//
// The effective JWKS host allowlist is the UNION of three layers: a compiled
// well-known IdP seed + the JWKS_HOST_ALLOWLIST env var + these admin-added
// rows. This is the persisted layer - hosts an admin adds at runtime (via the
// admin API) so onboarding a new customer IdP host never needs a redeploy. It
// is a convenience/runtime-flexibility choice: server-global, no deny-list, no
// lock flag. The existing https + exact-host-match SSRF validation is retained.
// ═══════════════════════════════════════════════════════════════════════════════

model JwksHostAllowlistEntry {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  host      String   @unique @db.VarChar(255)  // lowercased hostname, exact match
  label     String?  @db.VarChar(255)          // optional human note
  createdAt DateTime @default(now()) @db.Timestamptz
}

// WI-6: per-install data-encryption-key (DEK), stored WRAPPED by the KEK.
// The KEK lives only in env (CREDENTIAL_KEK); this wrapped DEK + its scrypt
// salt survive restart/redeploy/backup, while a DB dump alone stays inert.
model CredentialDek {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  wrappedDek String   @db.Text                 // v1.<iv>.<ct>.<tag> (KEK-wrapped)
  kekSalt    String   @db.VarChar(255)         // base64url scrypt salt
  active     Boolean  @default(true)
  createdAt  DateTime @default(now()) @db.Timestamptz
}

// WI-7: server-global key/value settings store. Holds the server-scope
// CredentialSecretVisibility (seeded to 'always'), plus room for future
// server-global settings. Endpoint-scope settings ride profile.settings.
model ServerSetting {
  key       String   @id @db.VarChar(128)
  value     String   @db.Text
  updatedAt DateTime @default(now()) @updatedAt @db.Timestamptz
}

